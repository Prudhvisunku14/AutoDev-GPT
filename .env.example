# DevPilot AI configuration template.
# Copy to `.env` and fill in values locally. Never commit `.env`.
# Every value below is a placeholder; empty means "must be set before the feature is used".

# --- Backend --------------------------------------------------------------
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=8000
# Long random string. Generate with:
#   <python> -c "import secrets; print(secrets.token_urlsafe(32))"
DEVPILOT_API_TOKEN=
DEVPILOT_CORS_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/devpilot.db
WORKSPACES_DIR=./workspaces
LOG_LEVEL=INFO

# --- OpenAI: GPT orchestrator (Responses API) -----------------------------
OPENAI_API_KEY=
# Model ID used by the orchestrator; set to a current GPT model from your account.
OPENAI_MODEL=
# Optional: custom endpoint (leave empty for the default OpenAI API)
OPENAI_BASE_URL=
# true = use previous_response_id chaining (responses stored by OpenAI).
# Phase 2 supports only true; transcript replay (false) arrives in a later phase.
OPENAI_STORE_RESPONSES=true
OPENAI_TIMEOUT_SECONDS=120
# SDK retries must stay 0: a retried call may be billed twice but would be counted once. Rate limits are still waited out.
OPENAI_MAX_RETRIES=0
# Required for real GPT calls: the most output tokens per turn. The budget reserves it before each call is sent.
OPENAI_MAX_OUTPUT_TOKENS=4000
# USD per 1M tokens, taken from your OpenAI pricing page (used for budget accounting).
# Leave empty if unknown: cost is then reported as unknown and RUN_MAX_TOKENS is the hard cap.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=

# --- Run limits (enforced in code) -----------------------------------------
MAX_TURNS=60
MAX_TOOL_CALLS=100
# Identical consecutive tool calls (same name and arguments) before the run is stopped
MAX_REPEATED_TOOL_CALLS=3
# Replies without a tool call that are answered with a reminder before the run is stopped
MAX_NUDGES=2
MAX_REPAIR_ITERATIONS=5
RUN_BUDGET_USD=2.00
RUN_MAX_TOKENS=1000000
RUN_WALL_CLOCK_SECONDS=1800
VERIFICATION_THRESHOLD=0.85
# Largest tool result (characters) returned to GPT
TOOL_OUTPUT_MAX_CHARS=20000
# true = every start needs the dashboard's spending approval of RUN_BUDGET_USD (scripts/live_server.py sets it).
# A dashboard build on a chosen stack needs one either way.
REQUIRE_SPEND_APPROVAL=false

# --- Earlier terminal builds -------------------------------------------------
# Run folders written by backend/scripts/live_demo.py and live_build.py. Shown read-only in the dashboard
# from each folder's summary.json and delivered files; their databases are never opened. Empty = none.
HISTORY_DIR=

# --- Live event stream (SSE) -------------------------------------------------
SSE_POLL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15
# Streams close after this long; clients reconnect with Last-Event-ID
SSE_MAX_STREAM_SECONDS=300

# --- Execution sandbox (Docker) -------------------------------------------
# The docker executable. Leave as "docker" when it is on PATH; otherwise give the full path.
DOCKER_CLI=docker
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=300
# Bytes kept per output stream; more is dropped and marked truncated. A flood beyond 16x kills the container.
SANDBOX_MAX_OUTPUT_BYTES=65536

# --- OpenCode coding engine (opencode serve) -------------------------------
# With OPENCODE_ENABLED=false the dashboard says "No coding engine is configured" and lists every setting still missing.
# Real builds from the dashboard: run backend/scripts/live_server.py instead of `python -m app`. It supplies the
# configuration that delivered the verified attendance build (model, prices, runtime image, verified binary, limits),
# runs the preflight, checks the key can see the model, dry-launches the containers and starts the guard. Those values,
# its limits and its paths are fixed in code and override this file; OPENAI_API_KEY and DEVPILOT_API_TOKEN come from here.
# Only OpenAI models are supported (OPENCODE_MODEL=openai/<model>).
OPENCODE_ENABLED=false
# A person's approval of Docker networks and real model calls. Live coding stays refused until this is true.
CODING_LIVE_APPROVED=false
# The approved runtime image's ID (sha256:...), which must hold ripgrep, and the verified binary's manifest.
OPENCODE_RUNTIME_IMAGE=
OPENCODE_MANIFEST_FILE=
# A run's disposable copy of the project. It must be outside the repository. Empty: %LOCALAPPDATA%\DevPilot\server-work.
# On a laptop with little space on C:, point it at another drive, e.g. D:/DevPilotCache/work
# CODING_WORK_DIR=
MAX_REPAIR_ATTEMPTS=2
# Model gateway budgets, per coding attempt. The token budget is OPENCODE_MAX_TOKENS_PER_TASK.
GATEWAY_MAX_REQUESTS_PER_TASK=40
GATEWAY_MAX_OUTPUT_TOKENS=8000
GATEWAY_MAX_USD_PER_TASK=
# Loopback only; it must also be listed for the backend in config/egress_allowlist.yaml
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Format: provider/model, e.g. openai/<model-id>
OPENCODE_MODEL=
OPENCODE_TIMEOUT_SECONDS=600
# The project folder as the OpenCode container sees it
OPENCODE_WORKSPACE_DIR=/workspace
OPENCODE_MAX_TOKENS_PER_TASK=200000
OPENCODE_MAX_ATTEMPTS_PER_TASK=3
# Copies of the workspace taken before each coding task, used to revert it
CODING_CHECKPOINTS_DIR=./data/checkpoints

# --- n8n workflow integration ---------------------------------------------
# true wires trigger_workflow, get_workflow_result and the n8n routes (ARCHITECTURE §8.1)
N8N_ENABLED=false
N8N_BASE_URL=http://127.0.0.1:5678
# The only workflows GPT may trigger, with their inputs
N8N_WORKFLOWS_FILE=config/n8n_workflows.yaml
# Where n8n posts results, as n8n sees DevPilot (from a container: http://host.docker.internal:8000/integrations/n8n/callback)
N8N_CALLBACK_URL=
N8N_API_KEY=
# Shared secret for HMAC-signed webhooks/callbacks
N8N_WEBHOOK_SECRET=
# false = outbound n8n triggers need human approval
N8N_AUTO_APPROVE=false

# --- GitHub (all remote actions require approval) --------------------------
# Fine-grained personal access token scoped to the target repositories only
GITHUB_TOKEN=
GITHUB_OWNER=
# Largest repository (MB) that GitHub import will clone
GITHUB_IMPORT_MAX_MB=500
# Connect GitHub from the dashboard instead of pasting a token: register an OAuth App at
# https://github.com/settings/developers with the callback below, then set its ID and secret here. The token GitHub
# issues is stored encrypted with DEVPILOT_TOKEN_KEY under CREDENTIALS_DIR. Every write still waits for approval.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/github/callback
# repo: read the private repositories you choose and open approved pull requests
GITHUB_OAUTH_SCOPES=repo
CREDENTIALS_DIR=data/credentials

# --- Google Drive (OAuth 2.0, read-only scope) -----------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered in your Google Cloud OAuth client exactly. The path must be
# /oauth/google/callback; any other is refused when DRIVE_SOURCE=google.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
# Fernet key that encrypts stored OAuth refresh tokens. Generate with:
#   <python> -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVPILOT_TOKEN_KEY=

# --- Retrieval (RAG) ---------------------------------------------------------
# none: no real embedder (indexing stops with the reason). openai: OpenAI's embeddings API, paid, bounded below.
RAG_EMBEDDER=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
# Required for RAG_EMBEDDER=openai: the model's price per million input tokens, from OpenAI's pricing page
OPENAI_EMBEDDING_PRICE_PER_MTOK=
# Hard limit for one index build; a batch that could pass it is not sent
RAG_EMBEDDING_MAX_USD=0.10
RAG_INDEX_DIR=data/rag

# --- Dashboard ------------------------------------------------------------------
# Where the launcher's one-time sign-in link points (the browser then holds an HttpOnly session cookie, never the token)
DASHBOARD_URL=http://localhost:5173

# --- Document ingestion and network policy --------------------------------
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_EXTRACTED_CHARS=2000000
EGRESS_ALLOWLIST_FILE=config/egress_allowlist.yaml

# --- Adaptive tool selection -----------------------------------------------
# adaptive, or fixed for the first available provider in preference order.
SELECTION_POLICY=adaptive
# Initial weights, not tuned. They must add up to 1.
SELECTION_WEIGHT_CAPABILITY=0.30
SELECTION_WEIGHT_RELIABILITY=0.25
SELECTION_WEIGHT_QUALITY=0.15
SELECTION_WEIGHT_LATENCY=0.10
SELECTION_WEIGHT_COST=0.10
SELECTION_WEIGHT_RESOURCE=0.10
# Prior for (successes + alpha) / (attempts + alpha + beta).
SELECTION_RELIABILITY_ALPHA=2
SELECTION_RELIABILITY_BETA=2
# A value equal to its reference scores 0.5.
SELECTION_LATENCY_REFERENCE_SECONDS=120
SELECTION_COST_REFERENCE_USD=0.25
SELECTION_MEMORY_REFERENCE_MB=2048

# --- Failure recovery ------------------------------------------------------
# intelligent, or bounded for the fixed retry and repair rules.
RECOVERY_POLICY=intelligent
# The same failure this many times in a row: the action taken after it is not working.
RECOVERY_REPEAT_LIMIT=2
# Below this rate, over at least this many verified repairs, that repair is not tried.
RECOVERY_MIN_REPAIR_RATE=0.25
RECOVERY_MIN_REPAIR_SAMPLES=5
# The only setting recovery may change: how long one task's coding attempt may run.
# Empty means OPENCODE_TIMEOUT_SECONDS, so no attempt is given longer. A larger value turns that on.
RECOVERY_MAX_ATTEMPT_TIMEOUT_SECONDS=

# --- Opt-in integration tests (require approval; may cost money) -----------
RUN_DOCKER_TESTS=false
RUN_LIVE_OPENAI_TESTS=false
RUN_LIVE_OPENCODE_TESTS=false
RUN_LIVE_N8N_TESTS=false
RUN_LIVE_GOOGLE_TESTS=false
RUN_LIVE_GITHUB_TESTS=false
