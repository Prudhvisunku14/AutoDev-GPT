# Secrets: never commit real configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
credentials.bin
client_secret*.json
token*.json

# DevPilot CLI: what a user's own installation creates. These normally live in %LOCALAPPDATA%\DevPilot, outside this folder,
# but DEVPILOT_HOME or --home may point inside it, so they are ignored here too.
devpilot-output/
approved-runtime.json
build-ledger.jsonl
/tools/
/guard/
/work/
/checkpoints/
config.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
*.log

# Runtime data (SQLite DB, generated projects, reports)
data/
workspaces/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Frontend
node_modules/
dist/
frontend/.vite/
playwright-report/
test-results/

