# DevPilot AI dashboard: non-secret configuration only. Copy to .env.local to change it.
#
# Where the Vite dev server forwards /api requests: the FastAPI backend started with `python -m app` from backend/.
DEVPILOT_BACKEND_URL=http://127.0.0.1:8000
# The API path the browser calls. Keep it relative so requests go through the dev server's proxy.
VITE_API_BASE_URL=/api/v1
#
# Never put the backend's DEVPILOT_API_TOKEN, an OpenAI key or any other secret here: VITE_ variables are compiled into
# the page. The token is typed into the dashboard and kept only in the browser tab's sessionStorage.
